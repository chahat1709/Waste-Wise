SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID=your-app-id
FIREBASE_MEASUREMENT_ID=your-measurement-id
# Optional: Firebase Admin service account JSON or path
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccount.json
EMAILJS_PUBLIC_KEY=your-emailjs-public-key
EMAILJS_SERVICE_ID=your-service-id
EMAILJS_TEMPLATE_ID=your-template-id
SOCKET_IO_URL=http://localhost:5000
ADMIN_KEY=dev-default-key
MAPPLS_API_KEY=your-mappls-key
FIRE_TEMP_THRESHOLD=60
FULLNESS_ALERT_THRESHOLD=80
PORT=5000
PYTHON_CMD=python
# Max API requests per IP per 15 min window (raise for tests/demos)
RATE_LIMIT_MAX=1000
